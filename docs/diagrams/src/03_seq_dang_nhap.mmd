sequenceDiagram
    autonumber
    actor U as Người dùng
    participant V as Trình duyệt<br/>(View Login)
    participant C as Account<br/>Controller
    participant H as IPassword<br/>Hasher
    participant DB as AppDbContext<br/>(EF Core)

    U->>V: Nhập email, mật khẩu,<br/>bấm "Đăng nhập"
    V->>V: Kiểm tra hợp lệ<br/>phía client
    V->>C: POST /dang-nhap<br/>(LoginViewModel + token)
    C->>C: Kiểm tra token chống<br/>giả mạo, ModelState
    C->>DB: Tìm Account theo Email
    DB-->>C: Account hoặc null
    alt Sai email hoặc mật khẩu
        C->>H: VerifyHashedPassword
        H-->>C: Failed
        C-->>V: View + lỗi "Email hoặc<br/>mật khẩu không đúng"
        V-->>U: Hiển thị lỗi
    else Tài khoản bị khóa
        C-->>V: View + lỗi<br/>"Tài khoản đã bị khóa"
        V-->>U: Hiển thị lỗi
    else Hợp lệ
        C->>H: VerifyHashedPassword
        H-->>C: Success
        C->>C: Tạo Claims, SignInAsync<br/>→ ghi cookie đăng nhập
        alt Vai trò Admin
            C-->>V: Chuyển tới /quan-tri
        else Vai trò Sinh viên
            C-->>V: Chuyển tới trang trước<br/>hoặc trang chủ
        end
        V-->>U: Hiển thị trang tương ứng
    end
