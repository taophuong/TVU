@model List<Banner>
@{
    ViewData["Title"] = "Banner trang chủ";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">@Model.Count banner</span>
        <a class="btn btn-primary btn-sm" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm banner</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle admin-table">
            <thead><tr><th>Thứ tự</th><th>Ảnh</th><th>Tiêu đề / Liên kết</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.DisplayOrder</td>
                        <td><img class="banner-thumb" src="@b.ImageUrl" alt="" /></td>
                        <td><strong>@b.Title</strong><div class="small text-muted">@b.LinkUrl</div></td>
                        <td><span class="badge @(b.IsActive ? "text-bg-success" : "text-bg-secondary")">@(b.IsActive ? "Đang hiển thị" : "Đang ẩn")</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.BannerId"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@b.BannerId" method="post" class="d-inline" onsubmit="return confirm('Xóa banner này?');">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
