@model BannerFormModel
@{
    ViewData["Title"] = Model.BannerId == 0 ? "Thêm banner" : "Sửa banner";
}

<div class="admin-card admin-form">
    <form asp-action="Save" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" asp-for="BannerId" />
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="LinkUrl" class="form-label"></label>
                <input asp-for="LinkUrl" class="form-control" placeholder="/tin-tuc/... hoặc https://..." />
                <span asp-validation-for="LinkUrl" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="ImageFile" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img class="banner-preview" src="@Model.ImageUrl" alt="Banner hiện tại" />
                }
                <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                <div class="form-text">Khuyến nghị tỉ lệ 16:6 (ví dụ 1600 × 600), tối đa 2 MB. Ảnh được hiển thị nguyên tỉ lệ, không bị cắt.</div>
                <span asp-validation-for="ImageFile" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary"><i class="bi bi-save"></i> Lưu</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>
