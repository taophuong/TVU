@model List<Faculty>
@{
    ViewData["Title"] = "Khoa";
    var counts = (Dictionary<int, (int Projects, int Accounts)>)ViewBag.Counts;
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">@Model.Count khoa</span>
        <a class="btn btn-primary btn-sm" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm khoa</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle admin-table">
            <thead><tr><th>Thứ tự</th><th>Tên khoa</th><th class="text-center">Dự án</th><th class="text-center">Tài khoản</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.DisplayOrder</td>
                        <td><strong>@f.FacultyName</strong><div class="small text-muted">@f.Description</div></td>
                        <td class="text-center">@counts[f.FacultyId].Projects</td>
                        <td class="text-center">@counts[f.FacultyId].Accounts</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@f.FacultyId"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@f.FacultyId" method="post" class="d-inline" onsubmit="return confirm('Xóa khoa này?');">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
