@model List<ContactRequest>
@{
    ViewData["Title"] = "Liên hệ hợp tác";
    ContactStatus? filter = ViewBag.Status;
    var counts = (Dictionary<ContactStatus, int>)ViewBag.Counts;
}

<div class="admin-card">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-sm @(filter == null ? "btn-primary" : "btn-outline-primary")" asp-action="Index">Tất cả <span class="badge text-bg-light">@counts.Values.Sum()</span></a>
        @foreach (var s in Enum.GetValues<ContactStatus>())
        {
            <a class="btn btn-sm @(filter == s ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-status="@s">
                @s.ToLabel() <span class="badge text-bg-light">@(counts.TryGetValue(s, out var n) ? n : 0)</span>
            </a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <p class="text-muted text-center py-4 mb-0">Không có yêu cầu liên hệ.</p>
    }
    @foreach (var c in Model)
    {
        <div class="contact-item @(c.Status == ContactStatus.Moi ? "is-new" : "")">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div>
                    <span class="badge @c.Status.ToBadgeClass()">@c.Status.ToLabel()</span>
                    <span class="badge text-bg-light">@c.RequestType.ToLabel()</span>
                    <strong class="ms-1">@c.FullName</strong>
                    @if (!string.IsNullOrEmpty(c.Organization))
                    {
                        <span class="text-muted">– @c.Organization</span>
                    }
                </div>
                <div class="small text-muted">
                    @if (c.Project != null)
                    {
                        <span>Dự án <a asp-area="" asp-controller="Projects" asp-action="Detail" asp-route-slug="@c.Project.Slug" target="_blank">@c.Project.ProjectName</a></span>
                    }
                    else
                    {
                        <span>Liên hệ chung</span>
                    }
                    · @c.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <p class="my-2">@c.Message</p>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="small">
                    <i class="bi bi-envelope"></i> <a href="mailto:@c.Email">@c.Email</a>
                    @if (!string.IsNullOrEmpty(c.Phone))
                    {
                        <span class="ms-3"><i class="bi bi-telephone"></i> @c.Phone</span>
                    }
                    @if (c.Handler != null)
                    {
                        <span class="ms-3 text-muted">Người xử lý: @c.Handler.FullName</span>
                    }
                </div>
                <div class="d-flex gap-2">
                    <form asp-action="UpdateStatus" asp-route-id="@c.ContactId" method="post" class="d-flex gap-2">
                        <input type="hidden" name="filter" value="@filter" />
                        <select name="status" class="form-select form-select-sm" asp-items="@(DisplayHelper.Options<ContactStatus>(s => s.ToLabel()).Select(o => { o.Selected = o.Value == c.Status.ToString(); return o; }))"></select>
                        <button class="btn btn-sm btn-outline-primary text-nowrap">Cập nhật</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@c.ContactId" method="post" onsubmit="return confirm('Xóa yêu cầu liên hệ này?');">
                        <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
