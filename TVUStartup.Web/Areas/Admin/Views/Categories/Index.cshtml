@model List<Category>
@{
    ViewData["Title"] = "Lĩnh vực";
    var counts = (Dictionary<int, int>)ViewBag.ProjectCounts;
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">@Model.Count lĩnh vực</span>
        <a class="btn btn-primary btn-sm" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm lĩnh vực</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle admin-table">
            <thead><tr><th>Thứ tự</th><th>Lĩnh vực</th><th>Slug</th><th class="text-center">Số dự án</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.DisplayOrder</td>
                        <td><i class="bi @(c.Icon ?? "bi-tag") me-1 text-primary"></i> <strong>@c.CategoryName</strong><div class="small text-muted">@c.Description</div></td>
                        <td><code>@c.Slug</code></td>
                        <td class="text-center">@counts[c.CategoryId]</td>
                        <td>@(c.IsActive ? "Đang sử dụng" : "Ngừng sử dụng")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CategoryId"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline" onsubmit="return confirm('Xóa lĩnh vực này?');">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
