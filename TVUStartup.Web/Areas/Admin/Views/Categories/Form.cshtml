@model CategoryFormModel
@{
    ViewData["Title"] = Model.CategoryId == 0 ? "Thêm lĩnh vực" : "Sửa lĩnh vực";
}

<div class="admin-card admin-form">
    <form asp-action="Save" method="post" novalidate>
        <input type="hidden" asp-for="CategoryId" />
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Icon" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i id="iconPreview" class="bi @(Model.Icon ?? "bi-tag")"></i></span>
                    <input asp-for="Icon" class="form-control" placeholder="bi-tree" />
                </div>
                <div class="form-text">Tra cứu tại <a href="https://icons.getbootstrap.com" target="_blank" rel="noopener">icons.getbootstrap.com</a></div>
                <span asp-validation-for="Icon" class="text-danger small"></span>
            </div>
            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check form-switch mt-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary"><i class="bi bi-save"></i> Lưu</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#Icon').on('input', function () { $('#iconPreview').attr('class', 'bi ' + (this.value || 'bi-tag')); });
    </script>
}
