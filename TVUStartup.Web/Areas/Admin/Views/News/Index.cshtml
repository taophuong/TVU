@model List<News>
@{
    ViewData["Title"] = "Tin tức & Sự kiện";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">@Model.Count bài viết</span>
        <a class="btn btn-primary btn-sm" asp-action="Create"><i class="bi bi-plus-lg"></i> Viết bài mới</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle admin-table">
            <thead><tr><th>Bài viết</th><th>Loại</th><th>Ngày tạo</th><th class="text-center">Lượt xem</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var n in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(n.Thumbnail))
                                {
                                    <img asp-append-version="true" class="cover-thumb" src="@n.Thumbnail" alt="" />
                                }
                                <div class="min-w-0">
                                    <strong>@n.Title</strong>
                                    <div class="small text-muted">@n.Author.FullName</div>
                                </div>
                            </div>
                        </td>
                        <td>@n.NewsType.ToLabel()</td>
                        <td>@n.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">@n.ViewCount</td>
                        <td><span class="badge @(n.IsPublished ? "text-bg-success" : "text-bg-secondary")">@(n.IsPublished ? "Đã xuất bản" : "Bản nháp")</span></td>
                        <td class="text-end text-nowrap">
                            @if (n.IsPublished)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@n.Slug" target="_blank"><i class="bi bi-eye"></i></a>
                            }
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@n.NewsId"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@n.NewsId" method="post" class="d-inline" onsubmit="return confirm('Xóa bài viết này?');">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
