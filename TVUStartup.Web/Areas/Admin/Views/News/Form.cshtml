@model NewsFormModel
@{
    ViewData["Title"] = Model.NewsId == 0 ? "Viết bài mới" : "Sửa bài viết";
}

<div class="admin-card admin-form-wide">
    <form asp-action="Save" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" asp-for="NewsId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NewsType" class="form-label"></label>
                <select asp-for="NewsType" asp-items="@(DisplayHelper.Options<NewsType>(t => t.ToLabel()))" class="form-select"></select>
            </div>
            <div class="col-12">
                <label asp-for="Summary" class="form-label"></label>
                <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-4">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" />
                <div class="form-text">Dùng cho sự kiện / cuộc thi.</div>
            </div>
            <div class="col-md-8">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
            </div>
            <div class="col-md-8">
                <label asp-for="ThumbnailFile" class="form-label"></label>
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.Thumbnail))
                    {
                        <img asp-append-version="true" class="cover-thumb" src="@Model.Thumbnail" alt="" />
                    }
                    <input asp-for="ThumbnailFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                </div>
                <span asp-validation-for="ThumbnailFile" class="text-danger small"></span>
            </div>
            <div class="col-md-4 d-flex align-items-center">
                <div class="form-check form-switch mt-3">
                    <input asp-for="IsPublished" class="form-check-input" />
                    <label asp-for="IsPublished" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12">
                <label class="form-label">Nội dung</label>
                <div id="contentEditor" class="content-editor"></div>
                <input type="hidden" asp-for="Content" id="contentInput" />
                <span asp-validation-for="Content" class="text-danger small"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary"><i class="bi bi-save"></i> Lưu bài viết</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_EditorScripts" />
}
