@model News
<a class="news-card" asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@Model.Slug">
    <div class="news-thumb">
        @if (!string.IsNullOrEmpty(Model.Thumbnail))
        {
            <img src="@Model.Thumbnail" alt="@Model.Title" loading="lazy" />
        }
        <span class="news-type">@Model.NewsType.ToLabel()</span>
    </div>
    <div class="news-body">
        <div class="news-date">
            <i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("dd/MM/yyyy")
            @if (Model.EventDate.HasValue)
            {
                <span class="ms-2"><i class="bi bi-clock"></i> Diễn ra: @Model.EventDate.Value.ToString("dd/MM/yyyy")</span>
            }
        </div>
        <h3 class="news-title">@Model.Title</h3>
        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <p class="news-summary">@Model.Summary</p>
        }
    </div>
</a>
