@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TVU Startup</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Website giới thiệu các sản phẩm khởi nghiệp của Sinh viên Trường Đại học Trà Vinh")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-rocket-takeoff-fill"></i></span>
                    <span class="brand-text">TVU <strong>Startup</strong></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <i class="bi bi-list"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index">Dự án khởi nghiệp</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "News" ? "active" : "")" asp-controller="News" asp-action="Index">Tin tức & Sự kiện</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index">Liên hệ</a>
                        </li>
                    </ul>
                    <form class="nav-search" method="get" asp-controller="Projects" asp-action="Index" role="search">
                        <i class="bi bi-search"></i>
                        <input type="search" name="q" class="form-control" placeholder="Tìm dự án..." aria-label="Tìm dự án" />
                    </form>
                    <div class="nav-user">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var avatar = User.GetAvatar();
                            var name = User.Identity.Name ?? "";
                            <div class="dropdown">
                                <button class="btn user-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(avatar))
                                    {
                                        <img class="avatar avatar-sm" src="@avatar" alt="" />
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-sm">@DisplayHelper.Initial(name)</span>
                                    }
                                    <span class="user-name">@name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsAdmin())
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Trang quản trị</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-controller="MyProjects" asp-action="Index"><i class="bi bi-kanban"></i> Dự án của tôi</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="MyProjects" asp-action="Contacts"><i class="bi bi-envelope"></i> Liên hệ hợp tác</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-person"></i> Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key"></i> Đổi mật khẩu</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Đăng nhập</a>
                            <a class="btn btn-sm btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <a class="navbar-brand text-white mb-3 d-inline-flex" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark"><i class="bi bi-rocket-takeoff-fill"></i></span>
                        <span class="brand-text">TVU <strong>Startup</strong></span>
                    </a>
                    <p class="footer-text">Nơi giới thiệu và kết nối các sản phẩm khởi nghiệp của Sinh viên Trường Đại học Trà Vinh với cộng đồng, doanh nghiệp và nhà đầu tư.</p>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="footer-title">Khám phá</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-controller="Projects" asp-action="Index">Tất cả dự án</a></li>
                        <li><a asp-controller="Projects" asp-action="Index" asp-route-sort="views">Dự án xem nhiều</a></li>
                        <li><a asp-controller="News" asp-action="Index">Tin tức & Sự kiện</a></li>
                        <li><a asp-controller="MyProjects" asp-action="Create">Đăng dự án</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Liên hệ Ban quản trị</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h6 class="footer-title">Liên hệ</h6>
                    <ul class="footer-links">
                        <li><i class="bi bi-geo-alt"></i> Trường Đại học Trà Vinh, 126 Nguyễn Thiện Thành, Trà Vinh</li>
                        <li><i class="bi bi-globe"></i> <a href="https://www.tvu.edu.vn" target="_blank" rel="noopener">tvu.edu.vn</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; @DateTime.Now.Year Lê Văn Bình Phương – Chuyên đề ASP.NET – Trường Đại học Trà Vinh
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
