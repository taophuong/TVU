@* Dải tiêu đề đầu trang: đọc ViewData["Title"] và ViewData["Subtitle"] của view gọi tới *@
<section class="page-banner">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                @if (ViewData["ParentTitle"] is string parentTitle)
                {
                    <li class="breadcrumb-item"><a href="@ViewData["ParentUrl"]">@parentTitle</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>
        <h1 class="page-title">@ViewData["Title"]</h1>
        @if (ViewData["Subtitle"] is string subtitle)
        {
            <p class="page-sub">@subtitle</p>
        }
    </div>
</section>
