@model TVUStartup.Web.Models.ViewModels.HomeViewModel
@using TVUStartup.Web.Helpers
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- ===== Hero ===== -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-7">
                <span class="hero-eyebrow"><i class="bi bi-mortarboard-fill"></i> Trường Đại học Trà Vinh</span>
                <h1 class="hero-title">Sản phẩm khởi nghiệp của <span>Sinh viên TVU</span></h1>
                <p class="hero-lead">Khám phá các ý tưởng, sản phẩm và dự án khởi nghiệp do sinh viên Trường Đại học Trà Vinh xây dựng. Kết nối hợp tác, đầu tư và trải nghiệm sản phẩm.</p>
                <form class="hero-search" method="get" asp-controller="Projects" asp-action="Index" role="search">
                    <i class="bi bi-search"></i>
                    <input type="search" name="q" class="form-control" placeholder="Nhập tên dự án, sản phẩm..." aria-label="Tìm dự án" />
                    <button type="submit" class="btn btn-accent">Tìm kiếm</button>
                </form>
            </div>
            <div class="col-lg-5">
                <div class="hero-stats">
                    <div class="stat-tile">
                        <div class="stat-value">@Model.ProjectCount</div>
                        <div class="stat-label">Dự án đã giới thiệu</div>
                    </div>
                    <div class="stat-tile">
                        <div class="stat-value">@Model.CategoryCount</div>
                        <div class="stat-label">Lĩnh vực</div>
                    </div>
                    <div class="stat-tile">
                        <div class="stat-value">@Model.FacultyCount</div>
                        <div class="stat-label">Khoa có dự án</div>
                    </div>
                    <div class="stat-tile">
                        <div class="stat-value">@Model.TotalViews.ToCompact()</div>
                        <div class="stat-label">Lượt xem</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Dự án nổi bật ===== -->
@if (Model.FeaturedProjects.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 class="section-title">Dự án nổi bật</h2>
                    <p class="section-sub">Những sản phẩm khởi nghiệp tiêu biểu được ban quản trị lựa chọn</p>
                </div>
            </div>

            @{ var top = Model.FeaturedProjects[0]; }
            <a class="spotlight" asp-controller="Projects" asp-action="Detail" asp-route-slug="@top.Slug">
                <div class="row g-0 align-items-stretch">
                    <div class="col-lg-6 spotlight-media">
                        @if (!string.IsNullOrEmpty(top.CoverImage))
                        {
                            <img asp-append-version="true" src="@top.CoverImage" alt="@top.ProjectName" />
                        }
                    </div>
                    <div class="col-lg-6 spotlight-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(top.Logo))
                            {
                                <img asp-append-version="true" class="project-logo project-logo-lg" src="@top.Logo" alt="" />
                            }
                            <div>
                                <h3 class="spotlight-title">@top.ProjectName</h3>
                                @if (!string.IsNullOrEmpty(top.Slogan))
                                {
                                    <div class="spotlight-slogan">@top.Slogan</div>
                                }
                            </div>
                        </div>
                        <p class="spotlight-desc">@top.ShortDescription</p>
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            <span class="chip"><i class="bi @(top.CategoryIcon ?? "bi-tag")"></i> @top.CategoryName</span>
                            <span class="chip"><i class="bi bi-building"></i> @top.FacultyName</span>
                            <span class="stage-badge static @top.Stage.ToBadgeClass()">@top.Stage.ToLabel()</span>
                        </div>
                        <span class="btn btn-primary">Xem chi tiết <i class="bi bi-arrow-right"></i></span>
                    </div>
                </div>
            </a>

            @if (Model.FeaturedProjects.Count > 1)
            {
                <div class="row g-4 mt-1">
                    @foreach (var p in Model.FeaturedProjects.Skip(1))
                    {
                        <div class="col-md-6"><partial name="_ProjectCard" model="p" /></div>
                    }
                </div>
            }
        </div>
    </section>
}

<!-- ===== Lĩnh vực ===== -->
<section class="section section-alt">
    <div class="container">
        <div class="section-head">
            <div>
                <h2 class="section-title">Lĩnh vực khởi nghiệp</h2>
                <p class="section-sub">Duyệt dự án theo lĩnh vực bạn quan tâm</p>
            </div>
        </div>
        <div class="row g-3">
            @foreach (var c in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a class="category-tile" asp-controller="Projects" asp-action="Index" asp-route-category="@c.Slug">
                        <span class="category-icon"><i class="bi @(c.Icon ?? "bi-tag")"></i></span>
                        <span class="category-name">@c.CategoryName</span>
                        <span class="category-count">@c.ProjectCount dự án</span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===== Dự án mới ===== -->
<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <h2 class="section-title">Dự án mới nhất</h2>
                <p class="section-sub">Các dự án vừa được giới thiệu trên hệ thống</p>
            </div>
            <a class="btn btn-outline-primary" asp-controller="Projects" asp-action="Index">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        @if (Model.LatestProjects.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-inbox"></i><p>Chưa có dự án nào được giới thiệu.</p></div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var p in Model.LatestProjects)
                {
                    <div class="col-md-6 col-lg-4"><partial name="_ProjectCard" model="p" /></div>
                }
            </div>
        }
    </div>
</section>

<!-- ===== Banner sự kiện ===== -->
@if (Model.Banners.Count > 0)
{
    <section class="section section-alt">
        <div class="container">
            <div id="bannerCarousel" class="carousel slide banner-carousel" data-bs-ride="carousel">
                @if (Model.Banners.Count > 1)
                {
                    <div class="carousel-indicators">
                        @for (var i = 0; i < Model.Banners.Count; i++)
                        {
                            <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Banner @(i + 1)"></button>
                        }
                    </div>
                }
                <div class="carousel-inner">
                    @for (var i = 0; i < Model.Banners.Count; i++)
                    {
                        var b = Model.Banners[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            @if (!string.IsNullOrEmpty(b.LinkUrl))
                            {
                                <a href="@b.LinkUrl"><img asp-append-version="true" src="@b.ImageUrl" class="d-block w-100" alt="@b.Title" /></a>
                            }
                            else
                            {
                                <img asp-append-version="true" src="@b.ImageUrl" class="d-block w-100" alt="@b.Title" />
                            }
                        </div>
                    }
                </div>
                @if (Model.Banners.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Trước</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Sau</span>
                    </button>
                }
            </div>
        </div>
    </section>
}

<!-- ===== Tin tức ===== -->
@if (Model.LatestNews.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 class="section-title">Tin tức & Sự kiện</h2>
                    <p class="section-sub">Hoạt động khởi nghiệp dành cho sinh viên TVU</p>
                </div>
                <a class="btn btn-outline-primary" asp-controller="News" asp-action="Index">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var n in Model.LatestNews)
                {
                    <div class="col-md-6 col-lg-4"><partial name="_NewsCard" model="n" /></div>
                }
            </div>
        </div>
    </section>
}

<!-- ===== Kêu gọi đăng dự án ===== -->
<section class="section cta-section">
    <div class="container">
        <div class="cta-box">
            <div>
                <h2>Bạn đang có dự án khởi nghiệp?</h2>
                <p>Đăng dự án lên TVU Startup để giới thiệu sản phẩm tới cộng đồng, doanh nghiệp và nhà đầu tư.</p>
            </div>
            <a class="btn btn-accent btn-lg" asp-controller="MyProjects" asp-action="Create"><i class="bi bi-plus-circle"></i> Đăng dự án</a>
        </div>
    </div>
</section>
