@{
    var code = (int)(ViewData["Code"] ?? 404);
    var (title, message) = code switch
    {
        404 => ("Không tìm thấy trang bạn yêu cầu", "Trang có thể đã bị xóa, đổi địa chỉ hoặc dự án chưa được duyệt."),
        403 => ("Bạn không có quyền truy cập trang này", "Chức năng này chỉ dành cho vai trò khác. Hãy đăng nhập bằng tài khoản phù hợp."),
        400 => ("Yêu cầu không hợp lệ", "Phiên làm việc có thể đã hết hạn. Vui lòng tải lại trang và thử lại."),
        _ => ("Đã có lỗi xảy ra", "Vui lòng thử lại sau.")
    };
    ViewData["Title"] = title;
}

<section class="error-page">
    <div class="container">
        <div class="error-code">@code</div>
        <h1 class="h3 fw-bold mt-3">@title</h1>
        <p class="text-muted">@message</p>
        <div class="d-flex gap-2 justify-content-center mt-4">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Về trang chủ</a>
            <a class="btn btn-outline-primary" asp-controller="Projects" asp-action="Index">Xem các dự án</a>
        </div>
    </div>
</section>
