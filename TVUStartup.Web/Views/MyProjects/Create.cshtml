@model ProjectFormModel
@{
    ViewData["Title"] = "Đăng dự án mới";
    ViewData["Subtitle"] = "Bước 1: nhập thông tin chung – sau đó bổ sung tính năng, hình ảnh, phiên bản, thành viên và gửi duyệt";
    ViewData["ParentTitle"] = "Dự án của tôi";
    ViewData["ParentUrl"] = Url.Action("Index");
}

<partial name="_PageBanner" />

<section class="section pt-4">
    <div class="container">
        <div class="content-card">
            <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <partial name="_ProjectFormFields" model="Model" />
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu nháp và tiếp tục</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_EditorScripts" />
}
